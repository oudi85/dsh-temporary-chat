{
  "name": "dsh-temporary-chat",
  "version": "1.2.0",
  "description": "可长期保留的临时对话：完整工具调用，关闭历史记忆读取与写入。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./registry": "./lib/registry.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts",
    "integration",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oudi85/dsh-temporary-chat.git"
  },
  "homepage": "https://github.com/oudi85/dsh-temporary-chat",
  "bugs": {
    "url": "https://github.com/oudi85/dsh-temporary-chat/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "temporary-chat",
    "memory-isolation"
  ]
}
